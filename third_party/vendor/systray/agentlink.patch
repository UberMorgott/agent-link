+// agentlink patch.
+var (
+	pGetDpiForWindow        = u32.NewProc("GetDpiForWindow")
+	pGetSystemMetricsForDpi = u32.NewProc("GetSystemMetricsForDpi")
+)
+
+// smallIconSize is the notification-area icon size at the window's DPI
+// (agentlink patch). LR_DEFAULTSIZE would load SM_CXICON, the large icon, and
+// the shell would then shrink it; before Windows 10 1607 the system DPI's
+// size is used.
+func (t *winTray) smallIconSize() (cx, cy uintptr) {
+	const SM_CXSMICON, SM_CYSMICON = 49, 50
+	if pGetDpiForWindow.Find() == nil && pGetSystemMetricsForDpi.Find() == nil {
+		if dpi, _, _ := pGetDpiForWindow.Call(uintptr(t.window)); dpi != 0 {
+			cx, _, _ = pGetSystemMetricsForDpi.Call(SM_CXSMICON, dpi)
+			cy, _, _ = pGetSystemMetricsForDpi.Call(SM_CYSMICON, dpi)
+			if cx != 0 && cy != 0 {
+				return cx, cy
+			}
+		}
+	}
+	cx, _, _ = pGetSystemMetrics.Call(SM_CXSMICON)
+	cy, _, _ = pGetSystemMetrics.Call(SM_CYSMICON)
+	return cx, cy
+}
