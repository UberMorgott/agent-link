{
  "mcpServers": {
    "agentlink": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/v:on", "/d", "/c",
        "set", "AL_MCP_EXE=&", "set", "AL_MCP_RUN=agentlink&",
        "(if", "defined", "PLUGIN_ROOT", "(set", "PATH=!PLUGIN_ROOT!\\bin;!PATH!&set", "AL_MCP_RUN=agentlink.cmd)",
        "else", "if", "defined", "CLAUDE_PLUGIN_ROOT", "(set", "PATH=!CLAUDE_PLUGIN_ROOT!\\bin;!PATH!&set", "AL_MCP_RUN=agentlink.cmd)",
        "else", "if", "exist", "!APPDATA!\\agentlink\\executable.path", "(set", "/p", "AL_MCP_EXE=<!APPDATA!\\agentlink\\executable.path))",
        "&", "(if", "defined", "AL_MCP_EXE", "set", "PATH=!AL_MCP_EXE:\\agentlink.exe=!;!PATH!)",
        "&", "!AL_MCP_RUN!", "mcp"
      ]
    }
  }
}