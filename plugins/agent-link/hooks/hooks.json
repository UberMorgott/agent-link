{
  "description": "agent-link: deliver project chat messages to this Codex session through the bundled launcher",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/agentlink\" hook codex",
            "commandWindows": "\"${PLUGIN_ROOT}/bin/agentlink.cmd\" hook codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/agentlink\" hook codex",
            "commandWindows": "\"${PLUGIN_ROOT}/bin/agentlink.cmd\" hook codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/agentlink\" hook codex",
            "commandWindows": "\"${PLUGIN_ROOT}/bin/agentlink.cmd\" hook codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/agentlink\" hook codex",
            "commandWindows": "\"${PLUGIN_ROOT}/bin/agentlink.cmd\" hook codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/agentlink\" hook codex",
            "commandWindows": "\"${PLUGIN_ROOT}/bin/agentlink.cmd\" hook codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/agentlink\" hook codex",
            "commandWindows": "\"${PLUGIN_ROOT}/bin/agentlink.cmd\" hook codex",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/agentlink\" hook codex",
            "commandWindows": "\"${PLUGIN_ROOT}/bin/agentlink.cmd\" hook codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/agentlink\" hook codex",
            "commandWindows": "\"${PLUGIN_ROOT}/bin/agentlink.cmd\" hook codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
