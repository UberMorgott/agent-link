{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${PLUGIN_ROOT}/scripts/agentlink.ps1\" hook codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${PLUGIN_ROOT}/scripts/agentlink.ps1\" hook codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${PLUGIN_ROOT}/scripts/agentlink.ps1\" hook codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${PLUGIN_ROOT}/scripts/agentlink.ps1\" hook codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${PLUGIN_ROOT}/scripts/agentlink.ps1\" hook codex",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${PLUGIN_ROOT}/scripts/agentlink.ps1\" hook codex",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
